# Round 2 and 4 call Anthropic; Round 3 calls OpenAI. Round 1 needs neither.
# Never commit a filled-in .env - this file is the template only.

# --- Rounds 2 & 4: Claude ---------------------------------------------
# Required by `write-draft`, and by `finalize` when the review asked for
# revisions. A PASS finalization is a byte copy and needs no key at all.
# ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Falls back to ANTHROPIC_MODEL, then to the default.
# ANTHROPIC_FINALIZER_MODEL=

# Optional writer tuning.
# GOLDPIPELINE_WRITER_TIMEOUT=120
# GOLDPIPELINE_WRITER_MAX_RETRIES=2
# GOLDPIPELINE_WRITER_MAX_TOKENS=8000

# Optional finalizer tuning.
# GOLDPIPELINE_FINALIZER_TIMEOUT=120
# GOLDPIPELINE_FINALIZER_MAX_RETRIES=2
# GOLDPIPELINE_FINALIZER_MAX_TOKENS=8000

# --- Round 3: ChatGPT Reviewer ----------------------------------------
# Required by `review-draft` (not by `--fake-reviewer`).
# OPENAI_API_KEY=

# Optional. Defaults to gpt-5.1; --model overrides both.
# OPENAI_REVIEW_MODEL=gpt-5.1

# Optional reviewer tuning.
# GOLDPIPELINE_REVIEW_TIMEOUT=120
# GOLDPIPELINE_REVIEW_MAX_RETRIES=2
# GOLDPIPELINE_REVIEW_MAX_TOKENS=8000

# --- pipeline ---------------------------------------------------------
# GOLDPIPELINE_RUNS_DIR=runs
# GOLDPIPELINE_LOG_LEVEL=INFO

# --- Round 6: Telegram publisher --------------------------------------
# Required by `publish` (not by `--fake-publisher`).
# The token appears in the Bot API URL, so treat it as a live credential:
# never paste it into a log, an issue, or a commit.
# TELEGRAM_BOT_TOKEN=

# Destination. Either a public @username or a numeric chat id
# (channels are negative, e.g. -1002145890733). This is the only place the
# destination comes from - no CLI flag can redirect it.
# TELEGRAM_TARGET_CHAT_ID=

# Optional publisher tuning.
# GOLDPIPELINE_PUBLISH_TIMEOUT=30
