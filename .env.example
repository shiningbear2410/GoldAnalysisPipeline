# Round 2 and 4 call Anthropic; Round 3 calls OpenAI. Round 1 needs neither.
# Never commit a filled-in .env - this file is the template only.

# --- Rounds 2 & 4: Claude ---------------------------------------------
# Required by `write-draft`, and by `finalize` when the review asked for
# revisions. A PASS finalization is a byte copy and needs no key at all.
# ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Falls back to ANTHROPIC_MODEL, then to the default.
# ANTHROPIC_FINALIZER_MODEL=

# Optional writer tuning.
# GOLDPIPELINE_WRITER_TIMEOUT=120
# GOLDPIPELINE_WRITER_MAX_RETRIES=2
# GOLDPIPELINE_WRITER_MAX_TOKENS=8000

# Optional finalizer tuning.
# GOLDPIPELINE_FINALIZER_TIMEOUT=120
# GOLDPIPELINE_FINALIZER_MAX_RETRIES=2
# GOLDPIPELINE_FINALIZER_MAX_TOKENS=8000

# --- Round 3: ChatGPT Reviewer ----------------------------------------
# Required by `review-draft` (not by `--fake-reviewer`).
# OPENAI_API_KEY=

# Optional. Defaults to gpt-5.1; --model overrides both.
# OPENAI_REVIEW_MODEL=gpt-5.1

# Optional reviewer tuning.
# GOLDPIPELINE_REVIEW_TIMEOUT=120
# GOLDPIPELINE_REVIEW_MAX_RETRIES=2
# GOLDPIPELINE_REVIEW_MAX_TOKENS=8000

# --- pipeline ---------------------------------------------------------
# GOLDPIPELINE_RUNS_DIR=runs
# GOLDPIPELINE_LOG_LEVEL=INFO

# --- Round 6: Telegram publisher --------------------------------------
# Required by `publish` (not by `--fake-publisher`).
# The token appears in the Bot API URL, so treat it as a live credential:
# never paste it into a log, an issue, or a commit.
# TELEGRAM_BOT_TOKEN=

# Destination. Either a public @username or a numeric chat id
# (channels are negative, e.g. -1002145890733). This is the only place the
# destination comes from - no CLI flag can redirect it.
# TELEGRAM_TARGET_CHAT_ID=

# Optional publisher tuning.
# GOLDPIPELINE_PUBLISH_TIMEOUT=30

# --- Round 8: live market data (MetaTrader 5) -------------------------
# The broker's own name for gold. Brokers rename it - XAUUSDm, GOLD,
# XAUUSD.a - and the pipeline never guesses: a symbol it cannot find is an
# error listing what the terminal does offer.
# GOLDPIPELINE_MT5_SYMBOL=XAUUSD

# What the article, the context and every downstream check call it. Set this
# only when it differs from the broker's name; both are recorded.
# GOLDPIPELINE_CANONICAL_SYMBOL=XAUUSD

# One of M1, M5, M15, M30, H1, H4.
# GOLDPIPELINE_OHLC_TIMEFRAME=M15

# How many closed candles to fetch. Between 10 and 500.
# GOLDPIPELINE_OHLC_BARS=20

# How old the newest closed candle may be before ingestion refuses. Usually
# a refusal here just means the market is closed - which is still a reason
# not to publish an analysis of it. Raise it deliberately for a backfill.
# GOLDPIPELINE_MAX_DATA_AGE_MINUTES=90

# No MT5 login or password is needed or read. The pipeline attaches to an
# already-authenticated terminal and only reads market data.

# --- Round 8: the analysis inbox --------------------------------------
# Where the producing bot drops its events.
# GOLDPIPELINE_INBOX_DIR=inbox

# --- Round 9: automation ----------------------------------------------
# The kill switch for the SCHEDULED worker. Default false, so registering
# a Task Scheduler task is not the same act as switching the system on.
# `automation-run-once` ignores this - a person typing it is the
# authorisation.
# GOLDPIPELINE_AUTOMATION_ENABLED=false

# Where the worker keeps its operational state.
# GOLDPIPELINE_AUTOMATION_DIR=automation

# How much one tick may do, and for how long. A tick is finite by design.
# GOLDPIPELINE_AUTOMATION_MAX_EVENTS_PER_TICK=3
# GOLDPIPELINE_AUTOMATION_MAX_TICK_MINUTES=10

# How old an analysis may be before it is too late to write about. Kept
# separate from - and shorter than - the market data limit: they answer
# different questions. This one exists to stop a Saturday note being
# paired with Monday's opening bars.
# GOLDPIPELINE_MAX_ANALYSIS_EVENT_AGE_MINUTES=60

# How long a deferred event waits before the worker looks again. The
# scheduler fires every minute; a market that was shut sixty seconds ago
# is still shut.
# GOLDPIPELINE_DEFER_RETRY_MINUTES=5

# --- Round 9: unattended publishing (OFF, and not yet activated) -------
# All three must agree before anything is sent. Leave these alone until a
# deliberate activation step.
# GOLDPIPELINE_AUTOPUBLISH_ENABLED=false

# Must be EXACTLY equal to TELEGRAM_TARGET_CHAT_ID. A mismatch fails
# closed - enabling publishing and naming where it may publish are two
# separate decisions on purpose.
# GOLDPIPELINE_AUTOPUBLISH_ALLOWED_TARGET=

# How old an approved Run may be and still be published unattended. Stops
# a backlog going out at once the moment automation is enabled.
# GOLDPIPELINE_AUTOPUBLISH_MAX_RUN_AGE_MINUTES=30

# --- Round 9.1: where credentials come from ---------------------------
# Resolution order is: this process's environment, then the operating
# system's credential store. Setting a variable here (or with `$env:`)
# still works and still wins - but it lives only in one process tree, so
# a Task Scheduler task will not see it. For unattended running, enroll
# credentials once instead:
#
#     .\.venv\Scripts\python.exe -m goldpipeline secrets-set anthropic
#     .\.venv\Scripts\python.exe -m goldpipeline secrets-set openai
#     .\.venv\Scripts\python.exe -m goldpipeline secrets-set telegram
#     .\.venv\Scripts\python.exe -m goldpipeline secrets-status
#
# Each prompts invisibly. Nothing is written to this file, to the
# registry, or to the Task Scheduler definition.
#
# Only these three are credentials. TELEGRAM_TARGET_CHAT_ID, the MT5
# symbol, the timeframe and the automation flags are configuration and
# belong in the environment where they can be read back and checked.
