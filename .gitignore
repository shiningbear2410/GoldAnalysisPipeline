# secrets
.env
.env.*
!.env.example

# runs are generated artifacts, not source
runs/*
!runs/.gitkeep

# the live analysis inbox holds production input and its ledger, not source
inbox/*
!inbox/.gitkeep

# automation worker state: a dashboard, tick history and backoff records
automation/*
!automation/.gitkeep

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
